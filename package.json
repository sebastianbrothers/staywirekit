{
  "name": "sendwirekit",
  "version": "0.1.0",
  "private": true,
  "description": "sendwire digital brand kit — tokens, branded shadcn suite, Storybook brand guide, and AI handoff layer",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "build:tokens": "pnpm --filter @sendwirekit/tokens build",
    "build:handoff": "pnpm --filter @sendwirekit/handoff build",
    "storybook": "pnpm --filter @sendwirekit/storybook storybook",
    "build-storybook": "pnpm --filter @sendwirekit/storybook build",
    "ui:add": "pnpm --filter @sendwirekit/ui ui:add",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.5.4",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
